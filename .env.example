# Contact form (app/api/contact/route.ts) — sends via Resend.
# Copy this file to .env.local and fill in a key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Defaults to "onboarding@resend.dev", which only delivers to the
# address that owns the Resend account. For production, verify a domain in
# Resend and set a from-address on it, e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM=
